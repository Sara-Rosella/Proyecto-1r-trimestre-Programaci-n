import java.util.ArrayList;
import java.util.Random;
import java.util.Scanner;

public class main_proyecto {
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(System.in);

        ArrayList<Character> adiv = new ArrayList<>();
        String nombre;
        int life = 7;
        ArrayList<String> var = new ArrayList<>();
        String[] desc = {"Bienvenido estimado aventurero al templo del DRAGÓN HERÁLDICO GUIVERNO BLANCO.\nDurante siglos un tesoro ha permanecido oculto en este lugar, centenares de aventureros lo han intentado conseguir sin exito pereciendo en el intento.\n¿Serás el primero en superar todas la pruebas que te deparen tus elecciones durante el camino? Tengo ganas de comprobarlo...\nAhora valiente aventurero,¿Cuál es tu nombre?: ", "Asi que tu nombre es " };

        String[] palabras = {"aventura", "tesoro", "heraldico", "escondite",}; //Pila de palabras para elegir aleatoriamente en las pruebas

        tpw(desc[0]);
        nombre = sc.nextLine();
        var.add(nombre);
        tpw(desc[1]);
        tpw(var.getFirst());

        ahorcado(life, palabras, sc);
    }

    public static int ahorcado (int life, String[] ans, Scanner sc){
        Random r = new Random();
        char[] show;
        String pal = ans[r.nextInt(ans.length)];
        int counter;
        char guess;
        String dummy;
        boolean correct;
        ArrayList<Character> adiv = new ArrayList<>();

        show = pal.toCharArray();
        counter = pal.length();


        for (int i = 0; i < pal.length(); i++) {
                show[i] = '_';
        }
        


        System.out.println("\nTienes " + life + " intentos para adivinar la palabra");
        for (int i = 0; i < pal.length(); i++) {
            System.out.print(show[i]);
            System.out.print(' ');
        }
        System.out.println(' ');

        do{
            System.out.println("Intentos restantes: " + life);
            System.out.println("Letras introducidas: " + adiv);
            System.out.println("Introduzca una letra o escriba adivinar para resolver la palabra");
            dummy = sc.next().toLowerCase();

            guess = dummy.toLowerCase().charAt(0);
            adiv.add(guess);

            correct = false;

            for (int i = 0; i < pal.length(); i++) {
                if (guess == pal.charAt(i)) {
                    show[i] = guess;
                    counter--;
                    correct = true;
                }
            }

            if (!correct) {
                System.out.println("La letra no está en la palabra");
                life--;
            } else {
                System.out.println("La letra está en la palabra");
            }

            if (life == 0){
                death();
            }
            for (int i = 0; i < pal.length(); i++) {
                System.out.print(show[i]);
                System.out.print(' ');
            }
            System.out.println(' ');
        }while(counter != 0);

        System.out.println("Palabra adivinada: " + pal);

        return life;
    }

        public static void death () {
            System.out.println("Te has quedado sin vidas, juego terminado");
            System.exit(0);
        }

        public static boolean comprobarInt (String opc) { //Función para comprobar que la opción introducida es un número y no crashee si meto una letra
            if (opc.isEmpty()) {
                return false;
            } else {
                for (int i = 0; i < opc.length(); i++) {
                    if (opc.charAt(i) > '9' || opc.charAt(i) < '0' || opc.length() != 1) {
                        return false;
                    }
                }
                return true;
            }
        }

        public static boolean comprobarNum3op (String opc)
        { //Función para comprobar que la opción introducida sea 1 2 o 3
            if (!comprobarInt(opc)) {
                return false;
            } else if (opc.charAt(0) != '1' && opc.charAt(0) != '2' && opc.charAt(0) != '3') {
                return false;
            } else {
                return true;
            }
        }

        public static boolean comprobarNum2op (String opc)
        { //Función para comprobar que la opción introducida sea 1 o 2
            if (!comprobarInt(opc)) {
                return false;
            } else if (opc.charAt(0) != '1' && opc.charAt(0) != '2') {
                return false;
            } else {
                return true;
            }
        }

        public static StringBuilder aciertoLetra (String palabra, String letra, StringBuilder guiones){
            int l = letra.charAt(0);

            System.out.println("Letra correcta");

            for (int i = 0; i < palabra.length(); i++) {
                if (palabra.charAt(i) == l) {
                    guiones.setCharAt(i, (char) l);
                }
            }
            return guiones;
        }

        public static boolean comprobarVidas ( int vidas){ //Funcion para comprobar las vidas al acabar las pruebas
            if (vidas <= 0) {
                System.out.println("TE HAS QUEDADO SIN VIDAS. FIN DE LA AVENTURA.");
                return false;
            }

            return true;
        }

        public static void tpw (String text) throws InterruptedException {
            for (int i = 0; i < text.length(); i++) {
                System.out.print(text.charAt(i));
                Thread.sleep(1);
            }
        }
}
